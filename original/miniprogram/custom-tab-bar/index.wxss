.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 8rpx 18rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  background: #FFFFFF;
  border-top: 1rpx solid #E8EFEB;
  box-shadow: 0 -6rpx 24rpx rgba(23,107,91,.06);
  z-index: 999;
}

.tab-item {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item-inner {
  width: 132rpx;
  height: 82rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tab-item.is-active .tab-item-inner {
  background: #E6F4EE;
}

.tab-icon {
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 2rpx;
}

.tab-item.is-active .tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  font-size: 22rpx;
  line-height: 30rpx;
  color: #8B9893;
  text-align: center;
  white-space: nowrap;
}

.tab-item.is-active .tab-text {
  color: #176B5B;
  font-weight: 700;
}
