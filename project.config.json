{
  "miniprogramRoot": "miniprogram/",
  "compileType": "miniprogram",
  "projectname": "ielts-365",
  "appid": "请替换为你的AppID",
  "libVersion": "3.4.10",
  "setting": {
    "es6": true,
    "postcss": true,
    "minified": true,
    "urlCheck": false,
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "ignoreUploadUnusedFiles": true
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "docs" }
    ]
  },
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
