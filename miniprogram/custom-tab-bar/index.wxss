.tabbar {
  position:fixed;
  left:0;
  right:0;
  bottom:0;
  height:calc(112rpx + env(safe-area-inset-bottom));
  padding:8rpx 18rpx env(safe-area-inset-bottom);
  box-sizing:border-box;
  display:flex;
  align-items:flex-start;
  background:var(--card, #FFFFFF);
  border-top:1rpx solid var(--line, #E8EFEB);
  box-shadow:0 -6rpx 24rpx rgba(23,107,91,.06);
  z-index:999;
}

.tab-item {
  flex:1;
  height:96rpx;
  display:flex;
  align-items:center;
  justify-content:center;
}

.tab-item-inner {
  width:132rpx;
  height:82rpx;
  border-radius:22rpx;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  box-sizing:border-box;
}

/* 选中态不再铺浅绿底：图标已分「灰/绿」双色（普通灰 #8B9893 / 选中绿 #176B5B），
   再叠色块反而三层强调显重。若想恢复，加回 .tab-item.is-active .tab-item-inner{background:var(--soft2, #E6F4EE)} */

.tab-icon {
  width:46rpx;
  height:46rpx;
  margin-bottom:2rpx;
  background-repeat:no-repeat;
  background-position:center;
  background-size:contain;
}

.tab-item.is-active .tab-icon {
  width:48rpx;
  height:48rpx;
}

.tab-text {
  font-size:22rpx;
  line-height:30rpx;
  color:var(--muted, #8B9893);
  text-align:center;
  white-space:nowrap;
}

.tab-item.is-active .tab-text {
  color:var(--green, #176B5B);
  font-weight:700;
}

/* iPad / 宽屏覆盖（纯追加，手机端不受影响），尺寸 = rpx × 0.5 */
@media (min-width:700px) {
  .tabbar {
    height:calc(56px + env(safe-area-inset-bottom));
    padding:4px 9px env(safe-area-inset-bottom);
    border-top-width:1px;
  }
  .tab-item { height:48px; }
  .tab-item-inner { width:66px; height:41px; border-radius:11px; }
  .tab-icon { width:23px; height:23px; margin-bottom:1px; }
  .tab-item.is-active .tab-icon { width:24px; height:24px; }
  .tab-text { font-size:11px; line-height:15px; }
}

/* 深色模式（.tabbar-dark 由组件 data.dark 驱动；token 不从 page 继承深色组，这里直接给值） */
.tabbar-dark {
  background: #131F21;
  border-top-color: #223430;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.4);
}
.tabbar-dark .tab-text { color: #7E938B; }
.tabbar-dark .tab-item.is-active .tab-text { color: #7CD6B4; }

