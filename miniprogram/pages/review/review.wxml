<!-- 复习页 -->
<view class="tab-row">
  <view class="tab {{tab === 'random' ? 'tab--on' : ''}}" data-tab="random" bindtap="onTab">随机抽查</view>
  <view class="tab {{tab === 'starred' ? 'tab--on' : ''}}" data-tab="starred" bindtap="onTab">重点词（{{starred.length}}）</view>
</view>

<!-- 随机抽查 -->
<block wx:if="{{tab === 'random'}}">
  <view class="card pool-info">
    <text class="muted">已学词汇池：{{poolSize}} 个（打卡越多，池子越大）</text>
  </view>

  <view class="card random-card" wx:if="{{current}}">
    <view class="random-word {{playingWord === current.w ? 'random-word--playing' : ''}}" bindtap="onSpeakCurrent">{{current.w}} 🔊</view>
    <view class="random-pos">{{current.p}}</view>

    <view class="random-zh" wx:if="{{showZh}}">
      <view class="random-zh-main">{{current.m}}</view>
      <view class="random-zh-ex {{playingWord === current.e ? 'random-word--playing' : ''}}" bindtap="onSpeakExample">🔈 {{current.e}}</view>
    </view>
    <button class="btn-ghost" wx:else bindtap="onShowZh">显示释义</button>

    <view class="random-actions">
      <view class="star-big" bindtap="onStarCurrent">{{current.starred ? '★ 已收藏' : '☆ 收藏'}}</view>
      <button class="btn-primary" bindtap="onNext">下一个</button>
    </view>
  </view>

  <view class="card" wx:else>
    <view class="empty-text">点击下方按钮，从已学词汇中随机抽查</view>
    <button class="btn-primary" bindtap="onNext">开始抽查</button>
  </view>
</block>

<!-- 重点词列表 -->
<block wx:if="{{tab === 'starred'}}">
  <view class="card" wx:if="{{!starred.length}}">
    <view class="empty-text">还没有收藏重点词。在学习页点词汇右侧的 ☆ 即可收藏，随机抽查会优先复习重点词。</view>
  </view>
  <view class="card" wx:else>
    <view class="word-row" wx:for="{{starred}}" wx:key="w">
      <view class="word-speak {{playingWord === item.w ? 'playing' : ''}}" data-word="{{item.w}}" bindtap="onSpeakStarred">🔊</view>
      <view class="word-main">
        <view><text class="word-en">{{item.w}}</text><text class="word-pos">{{item.p}}</text></view>
        <view class="word-zh">{{item.m}}</view>
        <view class="word-example">{{item.e}}</view>
      </view>
      <view class="word-remove" data-index="{{index}}" bindtap="onRemoveStarred">✕</view>
    </view>
  </view>
</block>
