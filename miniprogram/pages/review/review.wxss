/* 开溜 · 复习页 */
.tab-row{display:flex;background:#fff;margin:20rpx 24rpx;border-radius:44rpx;padding:8rpx}.tab{flex:1;text-align:center;font-size:28rpx;color:#8B9893;padding:14rpx 0;border-radius:40rpx}.tab--on{background:#176B5B;color:#fff;font-weight:700}.pool-info{padding:18rpx 28rpx}.random-card{text-align:center;padding:50rpx 30rpx}.random-word{font-size:56rpx;font-weight:800;color:#24332F;line-height:1.3}.random-word--playing{color:#176B5B}.random-pos{font-size:24rpx;color:#176B5B;font-style:italic;margin-top:6rpx}.random-zh{margin-top:30rpx}.random-zh-main{font-size:36rpx;color:#43504C}.random-zh-ex{font-size:26rpx;color:#82908B;margin-top:16rpx}.random-actions{display:flex;align-items:center;justify-content:space-between;margin-top:40rpx}.star-big{font-size:28rpx;color:#F5C451;padding:10rpx}.empty-text{font-size:26rpx;color:#8B9893;line-height:1.8;margin-bottom:24rpx}.word-remove{flex-shrink:0;width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;color:#C7D0CC;font-size:30rpx}

.review-result-row{display:flex;gap:20rpx;margin-top:30rpx}.review-result-btn{flex:1}
