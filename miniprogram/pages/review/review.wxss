/* 开溜 · 复习页 */
.tab-row{display:flex;background:#fff;margin:20rpx 24rpx;border-radius:44rpx;padding:8rpx}.tab{flex:1;text-align:center;font-size:28rpx;color:#8B9893;padding:14rpx 0;border-radius:40rpx}.tab--on{background:#176B5B;color:#fff;font-weight:700}.pool-info{padding:18rpx 28rpx}.random-card{text-align:center;padding:50rpx 30rpx}.random-head{display:flex;align-items:center;justify-content:center;gap:16rpx}.random-zh-ex{display:block;padding:6rpx 0}.random-word{font-size:56rpx;font-weight:800;color:#24332F;line-height:1.3}.random-word--playing{color:#176B5B}.random-pos{font-size:24rpx;color:#176B5B;font-style:italic;margin-top:6rpx}.random-zh{margin-top:30rpx}.random-zh-main{font-size:36rpx;color:#43504C}.random-zh-ex{font-size:26rpx;color:#82908B;margin-top:16rpx}.random-actions{display:flex;align-items:center;justify-content:space-between;margin-top:40rpx}.star-big{font-size:28rpx;color:#F5C451;padding:10rpx;transition:color .2s ease}
.star-big.on{color:#FF8A78;animation:star-pop .35s ease}
@keyframes star-pop{0%{transform:scale(1)}40%{transform:scale(1.2)}100%{transform:scale(1)}}.empty-text{font-size:26rpx;color:#8B9893;line-height:1.8;margin-bottom:24rpx}.word-remove{flex-shrink:0;width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;color:#C7D0CC;font-size:30rpx}

.review-result-row{display:flex;gap:20rpx;margin-top:30rpx}.review-result-btn{flex:1}

/* iPad / 宽屏覆盖（纯追加，手机端不受影响），字号 = rpx × 0.5 */
@media (min-width: 700px) {
  .tab-row { max-width: 640px; margin: 10px auto; border-radius: 22px; padding: 4px; box-sizing: border-box; }
  .tab { font-size: 14px; padding: 7px 0; border-radius: 20px; }
  .pool-info { padding: 9px 14px; }
  .random-card { padding: 25px 15px; }
  .random-word { font-size: 28px; }
  .random-pos { font-size: 12px; margin-top: 3px; }
  .random-zh { margin-top: 15px; }
  .random-zh-main { font-size: 18px; }
  .random-zh-ex { font-size: 13px; margin-top: 8px; }
  .random-actions { margin-top: 20px; }
  .star-big { font-size: 14px; padding: 5px; }
  .empty-text { font-size: 13px; margin-bottom: 12px; }
  .word-remove { width: 28px; height: 28px; font-size: 15px; }
  .review-result-row { gap: 10px; margin-top: 15px; }
}
