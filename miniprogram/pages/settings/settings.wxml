<!-- 设置页 -->
<view class="card"><view class="section-label">学习进度</view><view class="stat-row"><view class="stat-item"><view class="stat-num">{{totalChecked}}<text class="stat-denom"> / {{totalDays}}</text></view><view class="stat-label">已完成天数</view></view><view class="stat-item"><view class="stat-num">{{starredCount}}</view><view class="stat-label">重点词</view></view><view class="stat-item"><view class="stat-num">{{reviewCount}}</view><view class="stat-label">复习记录</view></view></view></view>
<view class="card"><view class="section-label">进度同步（多端）</view><view class="sync-row"><view class="sync-state"><text class="{{cloudOn?'sync-dot sync-dot--ok':'sync-dot'}}"></text><text>{{cloudOn?'云同步已开启':'云同步已关闭'}}</text></view><switch checked="{{cloudOn}}" color="#176B5B" bindchange="onCloudToggle" /></view><view class="sync-meta">{{cloudMeta}}</view><view class="sync-error" wx:if="{{cloudErr}}">{{cloudErr}}</view><view class="muted" style="margin-top:12rpx;">{{cloudTip}}</view><button class="btn-ghost" hover-class="btn-press" bindtap="onSyncNow" disabled="{{syncing}}" style="margin-top:16rpx;">{{syncing?'同步中…':'立即同步'}}</button></view>
<view class="card"><view class="section-label">计划开始日期（周一）</view><picker mode="date" value="{{startDate}}" start="2025-01-01" end="2028-12-31" bindchange="onStartDate"><view class="picker-value" hover-class="picker-value--press" hover-stay-time="120"><text>{{startDate}}</text><text class="picker-arrow"></text></view></picker><view class="muted" style="margin-top:10rpx;">选了非周一的日期会自动对齐到当周周一。</view></view>
<view class="card"><view class="section-label">朗读语速 {{rateText}}</view><slider min="0.7" max="1.3" step="0.05" value="{{rate}}" activeColor="#176B5B" block-size="24" bindchange="onRate" /><view class="btn-row"><button class="btn-ghost btn-voice {{voiceTesting?'btn-voice-on':''}}" hover-class="btn-press" bindtap="onTestVoice">{{voiceLabel}}</button></view></view>
<view class="card"><view class="section-label">朗读方式</view><picker range="{{engineOptions}}" range-key="label" value="{{engineIndex}}" bindchange="onEngineMode"><view class="picker-value" hover-class="picker-value--press" hover-stay-time="120"><text>{{engineOptions[engineIndex].label}}</text><text class="picker-arrow"></text></view></picker><view class="muted" style="margin-top:10rpx;">{{engineHint}}</view></view>
<view class="card"><view class="section-label">发音口音</view><picker range="{{accentOptions}}" range-key="label" value="{{accentIndex}}" bindchange="onAccent"><view class="picker-value" hover-class="picker-value--press" hover-stay-time="120"><text>{{accentOptions[accentIndex].label}}</text><text class="picker-arrow"></text></view></picker><view class="muted" style="margin-top:10rpx;">口音切换仅对「在线 TTS」音源生效。</view></view>
<view class="card"><view class="section-label">备份与重置</view><view class="muted">导出文本自行保存，换手机或换微信号时用来恢复；清除记录连云端一起清空，不可撤销。</view><view class="btn-row" style="margin-top:16rpx;"><button class="btn-ghost btn-half" hover-class="btn-press" bindtap="onExport">导出备份</button><button class="btn-ghost btn-half" hover-class="btn-press" bindtap="onShowImport">导入恢复</button></view>
<block wx:if="{{showBackup}}"><view class="backup-box"><textarea class="backup-text" value="{{backupText}}" maxlength="-1" show-confirm-bar="{{false}}" auto-height="{{false}}" /></view><view class="muted" style="margin-top:10rpx;">没复制上？长按上方框内文字手动全选复制。</view><view class="btn-row" style="margin-top:10rpx;"><button class="btn-ghost btn-half" hover-class="btn-press" bindtap="onCopyBackup">重新复制</button><button class="btn-ghost btn-half btn-plain" hover-class="btn-press" bindtap="onHideBackup">收起</button></view></block>
<block wx:if="{{showImport}}"><view class="backup-box" style="margin-top:16rpx;"><textarea class="backup-text" placeholder="把之前导出的备份内容粘贴到这里" value="{{importText}}" bindinput="onImportInput" maxlength="-1" show-confirm-bar="{{false}}" /></view><view class="muted" style="margin-top:10rpx;">合并：保留现有进度并补上备份内容；覆盖：以备份为准。</view><button class="btn-ghost" hover-class="btn-press" bindtap="onImportMerge" style="margin-top:10rpx;">合并导入</button><button class="btn-ghost" hover-class="btn-press" bindtap="onImportReplace" style="margin-top:10rpx;">覆盖导入</button><button class="btn-ghost btn-plain" hover-class="btn-press" bindtap="onHideImport" style="margin-top:10rpx;">取消</button></block><button class="btn-ghost btn-reset" hover-class="btn-press" bindtap="onResetProgress">清除学习记录</button></view>
<view class="card"><view class="section-label">{{aboutCardLabel}}</view><view class="about-btn" hover-class="hover-dim" hover-stay-time="120" bindtap="onAbout">{{aboutTitle}}</view><view class="muted about-ver" wx:if="{{appVersion}}">{{appVersion}}</view></view>
