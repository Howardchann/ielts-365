<page-meta page-style="{{pageStyle}}" />
<view class="page-root {{dark ? 'theme-dark' : ''}}">
<!-- 设置页 -->
<view class="card"><view class="section-label">学习进度</view><view class="stat-row"><view class="stat-item stat-item--tap {{statPress==='days'?'stat-item--press':''}}" data-pk="days" data-url="/pages/weeks/weeks" bindtouchstart="onStatDown" bindtouchmove="onStatMove" bindtouchend="onStatEnd" bindtouchcancel="onStatCancel" bindtap="onStatTap"><view class="stat-num">{{totalChecked}}<text class="stat-denom"> / {{totalDays}}</text><text class="stat-arrow"></text></view><view class="stat-label">已完成天数</view></view><view class="stat-item stat-item--tap {{statPress==='starred'?'stat-item--press':''}}" data-pk="starred" data-url="/pages/review/review" data-tab="starred" bindtouchstart="onStatDown" bindtouchmove="onStatMove" bindtouchend="onStatEnd" bindtouchcancel="onStatCancel" bindtap="onStatTap"><view class="stat-num">{{starredCount}}<text class="stat-arrow"></text></view><view class="stat-label">重点词</view></view><view class="stat-item stat-item--tap {{statPress==='review'?'stat-item--press':''}}" data-pk="review" data-url="/pages/review/review" data-tab="random" bindtouchstart="onStatDown" bindtouchmove="onStatMove" bindtouchend="onStatEnd" bindtouchcancel="onStatCancel" bindtap="onStatTap"><view class="stat-num">{{reviewCount}}<text class="stat-arrow"></text></view><view class="stat-label">复习记录</view></view></view></view>
<view class="card"><view class="section-label">外观</view><view class="seg-row"><view class="seg {{appearanceMode==='auto'?'seg--on':''}}" data-mode="auto" hover-class="btn-press" bindtap="onAppearance">跟随系统</view><view class="seg {{appearanceMode==='light'?'seg--on':''}}" data-mode="light" hover-class="btn-press" bindtap="onAppearance">浅色</view><view class="seg {{appearanceMode==='dark'?'seg--on':''}}" data-mode="dark" hover-class="btn-press" bindtap="onAppearance">深色</view></view><view class="muted" style="margin-top:12rpx;">跟随系统时，切到夜间会自动换成深色，无需手动操作</view></view>
<view class="card"><view class="section-label">进度同步（多端）</view><view class="sync-row"><view class="sync-state"><text class="{{cloudOn?'sync-dot sync-dot--ok':'sync-dot'}}"></text><text>{{cloudOn?'云同步已开启':'云同步已关闭'}}</text></view><switch checked="{{cloudOn}}" color="{{dark ? '#58B394' : '#2E8B72'}}" bindchange="onCloudToggle" /></view><view class="sync-meta">{{cloudMeta}}</view><view class="sync-error" wx:if="{{cloudErr}}">{{cloudErr}}</view><view class="muted" style="margin-top:12rpx;">{{cloudTip}}</view><button class="btn-ghost btn-fit" hover-class="btn-press" bindtap="onSyncNow" disabled="{{syncing}}" style="margin-top:16rpx;"><view class="ico ico-sync"></view>{{syncing?'同步中…':'立即同步'}}</button></view>
<view class="card"><view class="section-label">计划开始日期（周一）</view><view class="picker-value" hover-class="picker-value--press" hover-stay-time="120" bindtap="openCal"><text>{{startDate}}</text><text class="picker-arrow"></text></view><view class="muted" style="margin-top:10rpx;">只能选择今天及以后的日期；非周一会自动顺延到之后的第一个周一</view></view>
<view class="card"><view class="section-label">朗读语速 {{rateText}}</view><slider min="0.7" max="1.3" step="0.05" value="{{rate}}" activeColor="#176B5B" block-size="24" bindchange="onRate" /><view class="btn-row"><button class="btn-ghost btn-voice {{voiceTesting?'btn-voice-on':''}}" hover-class="btn-press" bindtap="onTestVoice"><view class="ico {{voiceTesting?'ico-stop':'ico-spk'}}"></view>{{voiceLabel}}</button></view></view>
<view class="card"><view class="section-label">朗读方式</view><view class="picker-value" hover-class="picker-value--press" hover-stay-time="120" bindtap="openEngineSheet"><text>{{engineOptions[engineIndex].label}}</text><text class="picker-arrow"></text></view><view class="muted" style="margin-top:10rpx;">{{engineHint}}</view></view>
<view class="card"><view class="section-label">发音口音</view><view class="picker-value" hover-class="picker-value--press" hover-stay-time="120" bindtap="openAccentSheet"><text>{{accentOptions[accentIndex].label}}</text><text class="picker-arrow"></text></view><view class="muted" style="margin-top:10rpx;">口音切换仅对「在线 TTS」音源生效</view></view>
<view class="card"><view class="section-label">备份与重置</view><view class="muted">导出文本自行保存，换手机或微信号时用于恢复；清除记录会连云端一起清空，不可撤销</view><view class="btn-row" style="margin-top:16rpx;"><button class="btn-ghost btn-half" hover-class="btn-press" bindtap="onExport"><view class="ico ico-up"></view>导出备份</button><button class="btn-ghost btn-half" hover-class="btn-press" bindtap="onShowImport"><view class="ico ico-down"></view>导入恢复</button></view>
<block wx:if="{{showBackup}}"><view class="backup-box"><textarea class="backup-text" value="{{backupText}}" maxlength="-1" show-confirm-bar="{{false}}" auto-height="{{false}}" /></view><view class="muted" style="margin-top:10rpx;">没复制上？长按上方文本手动全选复制</view><view class="btn-row" style="margin-top:10rpx;"><button class="btn-ghost btn-half" hover-class="btn-press" bindtap="onCopyBackup"><view class="ico ico-copy"></view>重新复制</button><button class="btn-ghost btn-half btn-plain" hover-class="btn-press" bindtap="onHideBackup"><view class="ico ico-uparrow"></view>收起</button></view></block>
<block wx:if="{{showImport}}"><view class="backup-box" style="margin-top:16rpx;"><textarea class="backup-text" placeholder="把之前导出的备份内容粘贴到这里" value="{{importText}}" bindinput="onImportInput" maxlength="-1" show-confirm-bar="{{false}}" /></view><view class="muted" style="margin-top:10rpx;">合并：保留现有进度并补上备份内容；覆盖：以备份为准</view><view class="btn-row" style="margin-top:10rpx;"><button class="btn-ghost btn-half" hover-class="btn-press" hover-stay-time="0" bindtap="onImportMerge"><view class="ico ico-merge"></view>合并导入</button><button class="btn-ghost btn-half" hover-class="btn-press" hover-stay-time="0" bindtap="onImportReplace"><view class="ico ico-cover"></view>覆盖导入</button></view><button class="btn-ghost btn-plain btn-fit" hover-class="btn-press" hover-stay-time="0" bindtap="onHideImport" style="margin-top:10rpx;">取消</button></block><button class="btn-ghost btn-reset btn-fit" hover-class="btn-press" hover-stay-time="0" bindtap="onResetProgress"><view class="ico ico-trash"></view>清除学习记录</button></view>
<view class="card"><view class="section-label">{{aboutCardLabel}}</view><view class="about-btn" hover-class="hover-dim" hover-stay-time="120" bindtap="onAbout">{{aboutTitle}}</view><view class="muted about-ver" wx:if="{{appVersion}}">{{appVersion}}</view></view>

<view class="sheet-mask" wx:if="{{sheet.show}}" bindtap="closeSheet" catchtouchmove="noop">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{sheet.title}}</view>
    <view class="sheet-opt {{sheet.index===index?'sheet-opt--on':''}}" wx:for="{{sheet.options}}" wx:key="label" hover-class="sheet-opt--press" data-i="{{index}}" bindtap="onSheetPick"><text>{{item.label}}</text><text class="sheet-check" wx:if="{{sheet.index===index}}">✓</text></view>
  </view>
</view>

<view class="sheet-mask" wx:if="{{cal.show}}" bindtap="closeCal" catchtouchmove="noop">
  <view class="sheet cal-sheet" catchtap="noop">
    <view class="sheet-title">选择开始日期</view>
    <view class="cal-head">
      <view class="cal-nav {{cal.canPrev?'':'cal-nav--dis'}}" hover-class="cal-nav--press" data-dir="-1" bindtap="shiftMonth">‹</view>
      <view class="cal-label">{{cal.label}}</view>
      <view class="cal-nav {{cal.canNext?'':'cal-nav--dis'}}" hover-class="cal-nav--press" data-dir="1" bindtap="shiftMonth">›</view>
    </view>
    <view class="cal-week"><text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text></view>
    <view class="cal-grid">
      <view class="cal-cell" wx:for="{{cal.grid}}" wx:key="iso">
        <view wx:if="{{!item.blank}}" class="cal-day {{item.dis?'cal-day--dis':''}} {{item.sel?'cal-day--sel':''}} {{item.today?'cal-day--today':''}}" hover-class="cal-day--press" data-iso="{{item.iso}}" data-dis="{{item.dis}}" bindtap="pickDay">{{item.d}}</view>
      </view>
    </view>
  </view>
</view>

<feedback id="fb"/>
</view>
