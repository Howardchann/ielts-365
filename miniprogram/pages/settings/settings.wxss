/* 开溜 · 设置页 */
.stat-line{font-size:30rpx;font-weight:700;color:#24332F;margin-bottom:8rpx}.picker-value{font-size:30rpx;color:#176B5B;background:#E6F4EE;border-radius:12rpx;padding:18rpx 24rpx}.btn-row{margin-top:20rpx}.btn-half{display:inline-block;padding:4rpx 40rpx;font-size:27rpx}.engine-status{font-size:24rpx;margin-top:14rpx;padding:14rpx 18rpx;border-radius:10rpx}.engine-status--ok{background:#E6F4EE;color:#176B5B}.engine-status--bad{background:#FDECEA;color:#C0392B}.sync-state{display:flex;align-items:center;font-size:26rpx;color:#53605B}.sync-dot{width:16rpx;height:16rpx;border-radius:50%;background:#C7D0CC;margin-right:14rpx;flex-shrink:0}.sync-dot--ok{background:#176B5B}.about-btn{font-size:28rpx;color:#176B5B;padding:8rpx 0}
