/* 设置页样式 */
.stat-line { font-size: 30rpx; font-weight: 600; color: #2C3E50; margin-bottom: 8rpx; }

.picker-value {
  font-size: 30rpx;
  color: #B8860B;
  background: #FFF6E0;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
}

.btn-row { margin-top: 20rpx; }
.btn-half { display: inline-block; padding: 4rpx 40rpx; font-size: 27rpx; }

.engine-status {
  font-size: 24rpx;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
}

.engine-status--ok { background: #E8F5E9; color: #2E7D32; }
.engine-status--bad { background: #FDECEA; color: #C0392B; }

.sync-state {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #555;
}

.sync-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: #ccc;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.sync-dot--ok { background: #2E7D32; }

.about-btn {
  font-size: 28rpx;
  color: #3498DB;
  padding: 8rpx 0;
}
