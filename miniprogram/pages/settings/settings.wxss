/* 开溜 · 设置页 */
.stat-line{font-size:30rpx;font-weight:700;color:#24332F;margin-bottom:8rpx}.picker-value{font-size:27rpx;color:#176B5B;background:#E6F4EE;border-radius:12rpx;padding:14rpx 24rpx}.btn-row{margin-top:20rpx}.btn-voice{display:inline-block;align-self:flex-start;padding:10rpx 44rpx;font-size:27rpx;white-space:nowrap}.engine-status{font-size:24rpx;margin-top:14rpx;padding:14rpx 18rpx;border-radius:10rpx}.engine-status--ok{background:#E6F4EE;color:#176B5B}.engine-status--bad{background:#FDECEA;color:#C0392B}.sync-state{display:flex;align-items:center;font-size:26rpx;color:#53605B}.sync-dot{width:16rpx;height:16rpx;border-radius:50%;background:#C7D0CC;margin-right:14rpx;flex-shrink:0}.sync-dot--ok{background:#176B5B}.sync-error{font-size:23rpx;color:#C0392B;background:#FDECEA;border-radius:10rpx;padding:12rpx 18rpx;margin-top:14rpx}.about-btn{font-size:28rpx;color:#176B5B;padding:8rpx 0}.about-ver{margin-top:4rpx}
.sync-row{display:flex;align-items:center;justify-content:space-between}.sync-meta{font-size:24rpx;color:#7B8A84;margin-top:12rpx}
.backup-box{margin-top:16rpx;border:1rpx solid #D6E4E0;border-radius:12rpx;background:#FBFDFC;overflow:hidden}.backup-text{width:100%;height:220rpx;padding:16rpx;box-sizing:border-box;font-size:22rpx;line-height:1.6;color:#4A5A56}.btn-plain{background:transparent!important;color:#7A8A86!important}
.btn-ghost.btn-voice-on{background:#176B5B;color:#fff;border-color:#176B5B}
.btn-reset{display:block;width:100%;margin-top:12rpx;color:#C0392B;border-color:#E8B4AE}

/* picker 行改为「值 + 右侧箭头」图标指引（替代「点击修改/点击切换」文字） */
.picker-value{display:flex;align-items:center;justify-content:space-between}
.picker-value--press{background:#CBE6DC}.picker-arrow{width:14rpx;height:14rpx;border-right:4rpx solid #7B8A84;border-bottom:4rpx solid #7B8A84;transform:rotate(-45deg);margin-left:12rpx;flex-shrink:0}

/* 学习进度三列统计（替代一行长文字，大字体下不再折行） */
.stat-row{display:flex;justify-content:space-around}
.stat-item{text-align:center}
.stat-num{font-size:40rpx;font-weight:800;color:#176B5B}
.stat-denom{font-size:24rpx;font-weight:400;color:#8B9893}
.stat-label{font-size:22rpx;color:#8B9893;margin-top:4rpx}

/* 按钮行固定 flex：导出/导入在长者模式/大字体下也保持并排 */
.btn-row{display:flex;gap:16rpx}
.btn-row .btn-half{flex:1;white-space:nowrap;padding:10rpx 0;font-size:27rpx}
.btn-reset{font-size:27rpx}

/* 设置页按钮统一规格：立即同步/合并导入/覆盖导入/取消/清除学习记录
   与导出备份/导入恢复（btn-half）同高同字号，并撑满卡片宽（去掉原生按钮两侧留白）。
   试听按钮（btn-voice）保持自适应宽度，不改。 */
.btn-ghost{width:100%;padding:10rpx 0;font-size:27rpx}
.btn-voice{width:auto;padding:10rpx 44rpx}

/* iPad / 宽屏覆盖（纯追加，手机端不受影响），字号 = rpx × 0.5 */
@media (min-width: 700px) {
  .stat-line { font-size: 15px; margin-bottom: 4px; }
  .picker-value { font-size: 14px; border-radius: 6px; padding: 7px 12px; }
  .btn-row { margin-top: 10px; }
  .btn-half { padding: 2px 20px; font-size: 14px; }
  .btn-ghost { width: 100%; padding: 2px 0; font-size: 14px; }
  .btn-voice { width: auto; padding: 2px 20px; }
  .engine-status { font-size: 12px; margin-top: 7px; padding: 7px 9px; border-radius: 5px; }
  .sync-state { font-size: 13px; }
  .sync-dot { width: 8px; height: 8px; margin-right: 7px; }
  .sync-error { font-size: 12px; border-radius: 5px; padding: 6px 9px; margin-top: 7px; }
  .sync-meta { font-size: 12px; margin-top: 6px; }
  .about-btn { font-size: 14px; padding: 4px 0; }
  .backup-box { margin-top: 8px; border-radius: 6px; }
  .backup-text { height: 110px; padding: 8px; font-size: 11px; }
  .picker-arrow { width: 7px; height: 7px; border-width: 2px; margin-left: 6px; }
  .stat-row { justify-content: space-around; }
  .stat-num { font-size: 20px; }
  .stat-denom { font-size: 12px; }
  .stat-label { font-size: 11px; margin-top: 2px; }
  .btn-row { gap: 8px; }
  .btn-reset { font-size: 14px; }
}
