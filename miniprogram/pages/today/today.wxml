<page-meta page-style="{{pageStyle}}" />
<view class="page-root {{dark ? 'theme-dark' : ''}}">
<!-- 今日学习计划 -->
<!-- 准备期：计划尚未开始 -->
<view class="card prestart-card" wx:if="{{preStart}}">
  <view class="prestart-title">准备期</view>
  <view class="prestart-sub">计划开始日前，可先熟悉操作</view>
  <view class="prestart-days">还有 {{daysToStart}} 天正式开学</view>
  <view class="tip-box">
    <view class="tip-text">可以提前浏览 Day 1 的内容，先熟悉操作：点<view class="ico-inline ico-spk"></view>听发音，点<view class="ico-inline ico-heart"></view>收藏重点词</view>
  </view>
  <button class="btn-primary btn-fit" hover-class="btn-press" bindtap="backToToday" style="margin-top:24rpx;">先看看 Day 1</button>
</view>

<block wx:else>
  <!-- 日期导航 -->
  <view class="card day-head">
    <view class="day-nav">
      <view class="nav-btn {{viewDay > 1 ? '' : 'nav-btn--dis'}}" hover-class="{{viewDay > 1 ? 'nav-btn--press' : 'none'}}" hover-stay-time="120" bindtap="prevDay">‹ 前一天</view>
      <view class="day-title">
        <view class="day-num">Day {{dayNum}}</view>
        <view class="day-dow">{{dowText}} · 第{{weekNum}}周</view>
      </view>
      <view class="nav-btn {{viewDay < totalDays ? '' : 'nav-btn--dis'}}" hover-class="{{viewDay < totalDays ? 'nav-btn--press' : 'none'}}" hover-stay-time="120" bindtap="nextDay">后一天 ›</view>
    </view>
    <view class="phase-line">{{phaseName}} · {{theme}}</view>
    <view class="is-today" wx:if="{{dayNum !== todayNum && todayNum > 0}}" hover-class="hover-dim" hover-stay-time="120" bindtap="backToToday">回到今天（Day {{todayNum}}）</view>
  </view>

  <!-- 标题与目标 -->
  <view class="card">
    <view class="section-label">{{dayData.t}}</view>
    <view class="obj-text" wx:if="{{dayData.obj}}">目标：{{dayData.obj}}</view>
    <view class="time-text" wx:if="{{dayData.time}}">建议时长：{{dayData.time}}</view>

    <!-- 打卡 -->
    <view class="checkin-btn" wx:if="{{dayData.type !== 'sat'}}">
      <button class="btn-primary btn-fit" wx:if="{{!checked}}" hover-class="btn-press" hover-stay-time="0" bindtap="onCheckin">完成打卡<view class="ico ico-check" style="margin-left:var(--ico-gap);margin-right:0"></view></button>
      <view class="done-state" wx:else>今日已完成<view class="ico ico-check" style="margin-left:var(--ico-gap);margin-right:0"></view></view>
      <button class="btn-ghost btn-cancel btn-fit" wx:if="{{checked}}" hover-class="btn-press" hover-stay-time="0" bindtap="onCheckin"><view class="ico ico-undo"></view>取消打卡</button>
    </view>
  </view>

  <!-- 学习日：词汇 -->
  <view class="card" wx:if="{{dayData.type === 'study'}}">
    <view class="section-label">本日词汇（{{vocab.length}}）</view>
    <view class="speak-all-row">
      <button class="btn-ghost btn-speak-all {{playingMode === 'queue' ? 'btn-speak-all--active' : ''}}" hover-class="btn-press" bindtap="onSpeakAll"><view class="ico {{playingMode === 'queue' ? 'ico-stop' : 'ico-play'}}"></view>{{playingMode === 'queue' ? '停止朗读' : '朗读全部'}}</button>
    </view>
    <block wx:for="{{vocab}}" wx:key="w">
      <view class="group-tag" wx:if="{{index === 0 && coreCount > 0}}">主题词 · {{coreCount}}</view>
      <view class="group-tag group-tag--extra" wx:if="{{index === extraStart}}">扩展词 · {{extraCount}}</view>
      <view class="word-row">
      <view class="word-speak {{playingText === item.w ? 'playing' : ''}}"
            hover-class="speak-hover" hover-stay-time="120"
            data-text="{{item.w}}" data-ai="{{item.ai}}" data-kind="w" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.w ? 'spk-ico--on' : ''}}"></view></view>
      <view class="word-main">
        <view><text class="word-en"><text wx:if="{{playingText === item.w}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.w ? karaRest : item.w}}</text><text class="word-pos">{{item.p}}</text></view>
        <view class="word-zh">{{item.m}}</view>
        <view class="word-example-row">
          <view class="word-example"
                data-text="{{item.e}}" data-ai="{{item.ai}}" data-kind="s" bindtap="onSpeakWord"><text wx:if="{{playingText === item.e}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.e ? karaRest : item.e}}</view>
          <view class="ex-speak {{playingText === item.e ? 'playing' : ''}}"
                hover-class="speak-hover" hover-stay-time="120"
                data-text="{{item.e}}" data-ai="{{item.ai}}" data-kind="s" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.e ? 'spk-ico--on' : ''}}"></view></view>
        </view>
      </view>
      <view class="word-star {{item.starred ? 'on' : ''}}" data-index="{{index}}" hover-class="hover-dim" hover-stay-time="120" bindtap="onStar"><view class="star-ico {{item.starred ? 'star-ico--on' : 'star-ico--off'}}"></view></view>
      </view>
    </block>
  </view>

  <!-- 学习日：语法 -->
  <view class="card" wx:if="{{dayData.type === 'study' && dayData.g}}">
    <view class="section-label">语法 · {{dayData.g.t}}</view>
    <view class="grammar-exp">{{dayData.g.exp}}</view>
    <view class="grammar-ex" wx:for="{{dayData.g.ex}}" wx:key="*this">
      <view class="ex-no">{{index + 1}}.</view>
      <text class="grammar-ex-text"><text wx:if="{{playingText === item}}" class="kara-lit">{{karaLit}}</text>{{playingText === item ? karaRest : item}}</text>
      <view class="ex-speak {{playingText === item ? 'playing' : ''}}"
            hover-class="speak-hover" hover-stay-time="120"
            data-text="{{item}}" data-kind="g" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item ? 'spk-ico--on' : ''}}"></view></view>
    </view>
  </view>

  <!-- 周六/周日不再单独渲染卡片：标题与目标卡已显示 dayData.t + obj，
       旧版这里再渲染一次「周六弹性日/周日自检 + 同一段 obj」，造成整段文字重复 -->

  <!-- 练习任务 -->
  <view class="card" wx:if="{{dayData.pr}}">
    <view class="section-label">{{dayData.type === 'sun' ? '自检任务' : (dayData.type === 'sat' ? '今日可选任务' : '练习任务')}}</view>
    <view class="practice-line" wx:for="{{prLines}}" wx:key="no"><text class="prac-no">{{item.no}}.</text><text>{{item.text}}</text></view>
  </view>

  <!-- 学习提示 -->
  <view class="card tip-box" wx:if="{{dayData.tip}}">
    <view class="section-label">学习提示</view>
    <view class="tip-text">{{dayData.tip}}</view>
  </view>
</block>

<feedback id="fb"/>
</view>
