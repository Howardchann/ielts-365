/* 开溜 · 今日页 */
.day-head{padding-bottom:16rpx}.day-nav{display:flex;align-items:center;justify-content:space-between}.nav-btn{font-size:26rpx;color:#176B5B;padding:14rpx 18rpx;border-radius:12rpx;background:#E6F4EE}
.nav-btn--press{background:#CBE6DC;transform:scale(.94);transition:transform .08s}.day-title{text-align:center;flex:1}.day-num{font-size:44rpx;font-weight:800;color:#24332F}.day-dow{font-size:24rpx;color:#8B9893;margin-top:4rpx}.phase-line{text-align:center;font-size:25rpx;color:#176B5B;margin-top:12rpx}.is-today{text-align:center;font-size:24rpx;color:#176B5B;margin-top:10rpx;padding:8rpx}.obj-text{font-size:27rpx;color:#53605B;margin-top:6rpx}.time-text{font-size:24rpx;color:#8B9893;margin-top:8rpx}.btn-cancel{margin-top:12rpx;background:none;color:#A5B0AC;font-size:24rpx;line-height:1.4;padding:6rpx}.btn-cancel::after{border:none}.speak-all-row{margin-bottom:10rpx}.btn-speak-all{font-size:26rpx;padding:2rpx 30rpx;display:inline-block}.btn-speak-all--active{background:#176B5B;color:#fff}.word-example--playing{color:#176B5B;font-weight:700}.grammar-exp{font-size:26rpx;color:#53605B;line-height:1.75;background:#F0F7F3;border-radius:12rpx;padding:20rpx 22rpx;margin-bottom:6rpx}.practice-text{font-size:26rpx;color:#53605B;line-height:1.8;white-space:pre-line}
.practice-line{font-size:26rpx;color:#53605B;line-height:1.8;margin-top:8rpx}
.practice-line:first-child{margin-top:0}.prestart-card{text-align:center;padding:60rpx 30rpx}.prestart-title{font-size:40rpx;font-weight:800;color:#176B5B}.prestart-sub{font-size:28rpx;color:#66736E;margin-top:14rpx}.prestart-days{font-size:60rpx;font-weight:800;color:#24332F;margin:30rpx 0}

/* 词汇分组标签：主题词 / 扩展词 */
.group-tag {
  font-size: 22rpx;
  color: #1d9e75;
  background: #e1f5ee;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin: 16rpx 0 6rpx;
  align-self: flex-start;
}
.group-tag--extra {
  color: #185fa5;
  background: #e6f1fb;
}

/* iPad / 宽屏覆盖（纯追加，手机端不受影响），字号 = rpx × 0.5 */
@media (min-width: 700px) {
  .nav-btn { font-size: 13px; padding: 7px 9px; }
  .day-num { font-size: 22px; }
  .day-dow { font-size: 12px; margin-top: 2px; }
  .phase-line { font-size: 13px; margin-top: 6px; }
  .is-today { font-size: 12px; margin-top: 5px; padding: 4px; }
  .obj-text { font-size: 14px; margin-top: 3px; }
  .time-text { font-size: 12px; margin-top: 4px; }
  .btn-cancel { font-size: 12px; margin-top: 6px; padding: 3px; }
  .btn-speak-all { font-size: 13px; padding: 1px 15px; }
  .grammar-exp { font-size: 13px; padding: 10px 11px; }
  .practice-text { font-size: 13px; }
  .practice-line { font-size: 13px; margin-top: 4px; }
  .prestart-card { padding: 30px 15px; }
  .prestart-title { font-size: 20px; }
  .prestart-sub { font-size: 14px; margin-top: 7px; }
  .prestart-days { font-size: 30px; margin: 15px 0; }
  .group-tag { font-size: 11px; border-radius: 4px; padding: 2px 7px; margin: 8px 0 3px; }
}
