/* 今日页样式 */
.day-head { padding-bottom: 16rpx; }

.day-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-btn {
  font-size: 26rpx;
  color: #B8860B;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #FFF6E0;
}

.day-title { text-align: center; flex: 1; }

.day-num { font-size: 44rpx; font-weight: 700; color: #2C3E50; }

.day-dow { font-size: 24rpx; color: #999; margin-top: 4rpx; }

.phase-line {
  text-align: center;
  font-size: 25rpx;
  color: #B8860B;
  margin-top: 12rpx;
}

.is-today {
  text-align: center;
  font-size: 24rpx;
  color: #3498DB;
  margin-top: 10rpx;
  padding: 8rpx;
}

.obj-text { font-size: 27rpx; color: #555; margin-top: 6rpx; }
.time-text { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.btn-cancel {
  margin-top: 12rpx;
  background: none;
  color: #bbb;
  font-size: 24rpx;
  line-height: 1.4;
  padding: 6rpx;
}
.btn-cancel::after { border: none; }

.speak-all-row { margin-bottom: 10rpx; }

.btn-speak-all { font-size: 26rpx; padding: 2rpx 30rpx; display: inline-block; }
.btn-speak-all--active { background: #B8860B; color: #fff; }

.word-example--playing { color: #B8860B; font-weight: 600; }

.grammar-exp {
  font-size: 26rpx;
  color: #555;
  background: #F8F6F0;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 10rpx;
}

.practice-text { font-size: 26rpx; color: #555; line-height: 1.8; white-space: pre-line; }

/* 准备期 */
.prestart-card { text-align: center; padding: 60rpx 30rpx; }
.prestart-title { font-size: 40rpx; font-weight: 700; color: #B8860B; }
.prestart-sub { font-size: 28rpx; color: #666; margin-top: 14rpx; }
.prestart-days { font-size: 60rpx; font-weight: 700; color: #2C3E50; margin: 30rpx 0; }
