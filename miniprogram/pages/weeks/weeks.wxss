/* 开溜 · 周总览页（含阶段折叠所需样式） */
.stat-card{padding:30rpx 20rpx}.stat-row{display:flex;justify-content:space-around}.stat-item{text-align:center}.stat-num{font-size:44rpx;font-weight:800;color:#176B5B}.stat-label{font-size:22rpx;color:#8B9893;margin-top:4rpx}.phase-title{display:flex;align-items:center;justify-content:space-between;font-size:30rpx;font-weight:800;color:#24332F;margin:30rpx 30rpx 6rpx;padding:0 16rpx;border-left:8rpx solid #FF8A78}.phase-toggle{font-size:24rpx;font-weight:400;color:#176B5B;flex-shrink:0}.week-card{padding:22rpx 26rpx;margin:14rpx 24rpx}.week-card--current{border:2rpx solid #9ED8C5;background:#F8FCF9}.week-line{display:flex;align-items:center}.week-ring{width:80rpx;height:80rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}.week-ring-num{width:62rpx;height:62rpx;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:700;color:#8B9893}.week-ring-num--past{color:#176B5B}.week-ring-num--current{color:#176B5B;font-weight:800}.week-info{flex:1;min-width:0;margin:0 20rpx}.week-theme{font-size:28rpx;font-weight:700;color:#24332F}.week-progress{display:flex;align-items:center;margin-top:10rpx}.progress-bar{flex:1;height:10rpx;border-radius:5rpx;background:#E9F0EC;overflow:hidden}.progress-fill{height:100%;background:#176B5B}.progress-text{font-size:20rpx;color:#8B9893;margin-left:12rpx}.week-tag{font-size:20rpx;color:#fff;background:#FF8A78;border-radius:8rpx;padding:4rpx 12rpx}.week-days{display:flex;margin-top:18rpx;gap:10rpx}

/* 阶段折叠箭头（替代「收起/展开」文字）：收起=▼，展开旋转 180° 变 ▲ */
.phase-arrow{width:16rpx;height:16rpx;border-right:4rpx solid #176B5B;border-bottom:4rpx solid #176B5B;transform:rotate(-45deg);transition:transform .25s ease;flex-shrink:0;margin-right:8rpx}
.phase-arrow--open{transform:rotate(135deg)}

/* 日签与周信息左对齐（让出 80rpx 进度环宽度），整卡成两列网格 */
.week-days{margin-left:0}.day-chip{flex:1;text-align:center;font-size:22rpx;color:#8B9893;background:#F3F8EF;border-radius:8rpx;padding:8rpx 0}.day-chip--done{background:#E6F4EE;color:#176B5B;font-weight:700}
.week-words{font-size:22rpx;color:#8B9893;margin-top:4rpx}

/* iPad / 宽屏覆盖（纯追加，手机端不受影响），字号 = rpx × 0.5 */
@media (min-width: 700px) {
  .stat-card { padding: 15px 10px; }
  .stat-num { font-size: 22px; }
  .stat-label { font-size: 11px; margin-top: 2px; }
  .phase-title { max-width: 640px; margin: 15px auto 3px; font-size: 15px; padding: 0 8px; box-sizing: border-box; }
  .phase-arrow { width: 8px; height: 8px; border-width: 2px; margin-right: 4px; }
  .week-card { margin: 7px auto; padding: 11px 13px; max-width: 640px; box-sizing: border-box; }
  .week-ring { width: 40px; height: 40px; }
  .week-ring-num { width: 31px; height: 31px; font-size: 12px; }
  .week-info { margin: 0 10px; }
  .week-theme { font-size: 14px; }
  .week-words { font-size: 11px; margin-top: 2px; }
  .progress-bar { height: 5px; border-radius: 3px; }
  .progress-text { font-size: 10px; margin-left: 6px; }
  .week-tag { font-size: 10px; border-radius: 4px; padding: 2px 6px; }
  .week-days { margin-top: 9px; margin-left: 0; gap: 5px; }
  .day-chip { font-size: 11px; border-radius: 4px; padding: 4px 0; }
}
