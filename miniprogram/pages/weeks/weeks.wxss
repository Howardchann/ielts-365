/* 开溜 · 周总览页（含阶段折叠所需样式） */
.stat-card{padding:30rpx 20rpx}.stat-row{display:flex;justify-content:space-around}.stat-item{text-align:center}.stat-num{font-size:44rpx;font-weight:800;color:var(--green)}.stat-label{font-size:22rpx;color:var(--muted);margin-top:4rpx}/* 方案C：阶段 2×2 磁贴总览。点磁贴展开周列表；当前阶段绿描边，展开阶段品牌绿描边 */
.phase-grid{display:flex;flex-wrap:wrap;justify-content:space-between;margin:14rpx 24rpx}
/* 两块 49% 留 2% 取整余量：精确 100% 求和在真机小数 rpx 下会因亚像素取整挤成单列 */
.phase-tile{width:49%;margin-bottom:14rpx;box-sizing:border-box;background:var(--card);border-radius:16rpx;padding:18rpx 20rpx;box-shadow:0 4rpx 18rpx rgba(23,107,91,.06);border:2rpx solid transparent}
.phase-tile--cur{border-color:var(--cur-line);background:var(--cur-bg)}
.phase-tile--open{border-color:var(--green)}
.tile-name{font-size:26rpx;font-weight:700;color:var(--ink)}
.tile-meta{font-size:20rpx;color:var(--muted);margin-top:4rpx}
.tile-bar{height:10rpx;border-radius:5rpx;background:var(--line);margin-top:12rpx;overflow:hidden}
.tile-fill{height:100%;background:var(--green-solid);border-radius:5rpx}.week-card{padding:22rpx 26rpx;margin:14rpx 24rpx}.week-card--current{border:2rpx solid var(--cur-line);background:var(--cur-bg)}.week-line{display:flex;align-items:center}.week-ring{width:80rpx;height:80rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}.week-ring-num{width:62rpx;height:62rpx;border-radius:50%;background:var(--card);display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:700;color:var(--muted)}.week-ring-num--past{color:var(--green)}.week-ring-num--current{color:var(--green);font-weight:800}.week-info{flex:1;min-width:0;margin:0 20rpx}.week-theme{font-size:28rpx;font-weight:700;color:var(--ink)}.week-progress{display:flex;align-items:center;margin-top:10rpx}.progress-bar{flex:1;height:10rpx;border-radius:5rpx;background:var(--line);overflow:hidden}.progress-fill{height:100%;background:var(--green-solid)}.progress-text{font-size:20rpx;color:var(--muted);margin-left:12rpx}.week-tag{font-size:20rpx;color:#fff;background:#FF8A78;border-radius:8rpx;padding:4rpx 12rpx}.week-days{display:flex;margin-top:18rpx;gap:10rpx}

/* 日签与周信息左对齐（让出 80rpx 进度环宽度），整卡成两列网格 */
.week-days{margin-left:0}.day-chip{flex:1;text-align:center;font-size:22rpx;color:var(--muted);background:var(--bg);border-radius:8rpx;padding:8rpx 0}.day-chip--done{background:var(--soft2);color:var(--green);font-weight:700}
.week-words{font-size:22rpx;color:var(--muted);margin-top:4rpx}

/* iPad / 宽屏覆盖（纯追加，手机端不受影响），字号 = rpx × 0.5 */
@media (min-width:700px) {
  .stat-card { padding:15px 10px; }
  .stat-num { font-size:22px; }
  .stat-label { font-size:11px; margin-top:2px; }
  .phase-grid { max-width:640px; margin:7px auto; }
  .phase-tile { width:49%; margin-bottom:7px; padding:9px 10px; border-radius:8px; }
  .tile-name { font-size:13px; }
  .tile-meta { font-size:10px; margin-top:2px; }
  .tile-bar { height:5px; border-radius:3px; margin-top:6px; }
  .week-card { margin:7px auto; padding:11px 13px; max-width:640px; box-sizing:border-box; }
  .week-ring { width:40px; height:40px; }
  .week-ring-num { width:31px; height:31px; font-size:12px; }
  .week-info { margin:0 10px; }
  .week-theme { font-size:14px; }
  .week-words { font-size:11px; margin-top:2px; }
  .progress-bar { height:5px; border-radius:3px; }
  .progress-text { font-size:10px; margin-left:6px; }
  .week-tag { font-size:10px; border-radius:4px; padding:2px 6px; }
  .week-days { margin-top:9px; margin-left:0; gap:5px; }
  .day-chip { font-size:11px; border-radius:4px; padding:4px 0; }
}
