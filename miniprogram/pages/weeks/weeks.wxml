<!-- 学习计划总览（78 周 / 18 个月） -->
<view class="card stat-card">
  <view class="stat-row">
    <view class="stat-item">
      <view class="stat-num">{{totalChecked}}</view>
      <view class="stat-label">已完成天数</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{totalDays - totalChecked}}</view>
      <view class="stat-label">剩余天数</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{totalPercent}}%</view>
      <view class="stat-label">总进度</view>
    </view>
  </view>
</view>

<view class="phase-block" wx:for="{{phases}}" wx:key="p" wx:for-item="phase">
  <view class="phase-title" data-p="{{phase.p}}" hover-class="hover-dim" hover-stay-time="120" bindtap="onPhaseTap">
    <text>{{phase.name}}</text>
    <text class="phase-arrow {{openPhase === phase.p ? 'phase-arrow--open' : ''}}"></text>
  </view>

  <block wx:if="{{openPhase === phase.p}}">
    <view class="card week-card {{week.isCurrent ? 'week-card--current' : ''}}"
          wx:for="{{phase.weeks}}" wx:key="w" wx:for-item="week"
          data-w="{{week.w}}" hover-class="hover-dim" hover-stay-time="120" bindtap="onWeekTap">
      <view class="week-line">
        <view class="week-ring" style="background: conic-gradient(#176B5B {{week.checked / 7 * 100}}%, #E9F0EC 0)"><view class="week-ring-num {{week.isCurrent ? 'week-ring-num--current' : (week.isPast ? 'week-ring-num--past' : '')}}">{{week.w}}</view></view>
        <view class="week-info">
          <view class="week-theme">{{week.theme}}</view>
          <view class="week-words">每日 {{week.perDay}} 词 · 本周 {{week.weekTotal}} 词</view>
        </view>
        <view class="week-tag" wx:if="{{week.isCurrent}}">本周</view>
      </view>
      <view class="week-days">
        <view class="day-chip {{item.done ? 'day-chip--done' : ''}}"
              wx:for="{{week.days}}" wx:key="k"
              data-w="{{week.w}}" data-k="{{item.k}}" hover-class="hover-dim" hover-stay-time="120" catchtap="onDayTap">{{item.k}}</view>
      </view>
    </view>
  </block>
</view>
