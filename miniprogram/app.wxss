/* 开溜 · 全局品牌样式 */
page {
  background: #F3F8EF;
  color: #24332F;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  /* 自定义 tabBar 高度约 112rpx：预留底部空间，避免最后一张卡片被导航栏遮住 */
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}
.card { background:#fff; border-radius:24rpx; padding:28rpx; margin:20rpx 24rpx; box-shadow:0 4rpx 18rpx rgba(23,107,91,.06); }
.section-label { font-size:26rpx; font-weight:700; color:#176B5B; margin-bottom:14rpx; letter-spacing:1rpx; }
.btn-primary { background:#176B5B; color:#fff; border-radius:44rpx; font-size:30rpx; font-weight:700; }
.btn-primary[disabled] { background:#CBD5D1; color:#fff; }
.btn-ghost { background:#fff; color:#176B5B; border:1.5rpx solid #A9DDD0; border-radius:44rpx; font-size:30rpx; }
.tip-box { background:#FFF7EA; border-left:6rpx solid #FF8A78; border-radius:14rpx; padding:20rpx 24rpx; margin-top:20rpx; }
.tip-text { color:#68574D; font-size:26rpx; }
.muted { color:#8B9893; font-size:24rpx; }
.brand-head { display:flex; align-items:center; padding:20rpx 28rpx 4rpx; }
.brand-logo { width:76rpx; height:76rpx; flex-shrink:0; }
.brand-copy { margin-left:16rpx; }
.brand-name { font-size:36rpx; line-height:1.1; font-weight:800; color:#176B5B; }
.brand-sub { font-size:22rpx; color:#7B8A84; margin-top:6rpx; }
.word-row { display:flex; align-items:flex-start; padding:18rpx 0; border-bottom:1rpx solid #E9F0EC; }
.word-row:last-child { border-bottom:none; }
.word-speak { flex-shrink:0; width:64rpx; height:64rpx; border-radius:50%; background:#E6F4EE; color:#176B5B; display:flex; align-items:center; justify-content:center; font-size:34rpx; margin-right:20rpx; }
.word-speak.playing { background:#176B5B; color:#fff; }
/* 按下即时反馈：小程序里 view 的 :active 不可靠，统一用 hover-class="speak-hover" */
.word-speak.speak-hover { background:#CBE6DC; }
.word-speak.playing.speak-hover { background:#0E4C41; }
.word-main { flex:1; min-width:0; }
.word-en { font-size:32rpx; font-weight:700; color:#24332F; }
.word-pos { font-size:22rpx; color:#176B5B; font-style:italic; margin-left:10rpx; }
.word-zh { font-size:26rpx; color:#5F6D68; margin-top:4rpx; }
.word-example { font-size:25rpx; color:#82908B; margin-top:6rpx; padding-left:4rpx; }
/* 例句行：文本占满 + 右侧播放按钮（与语法区 ex-speak 同款，让人一眼看出可以播） */
.word-example-row { display:flex; align-items:flex-start; }
.word-example-row .word-example { flex:1; min-width:0; }
.word-example-row .ex-speak { margin-top:2rpx; }
.word-star { flex-shrink:0; width:64rpx; height:64rpx; display:flex; align-items:center; justify-content:center; font-size:40rpx; color:#C7D0CC; transition:color .2s ease; }
.word-star.on { color:#FF8A78; animation:star-pop .35s ease; }
/* 收藏弹跳：空心→实心时 1→1.35→1 回弹（网易云式），取消收藏不播 */
@keyframes star-pop { 0%{transform:scale(1)} 40%{transform:scale(1.35)} 100%{transform:scale(1)} }
/* 语法例句：一句一行，长句自动折行。
   关键：flex 子项必须 min-width:0 —— 否则它的自动最小宽度按内容算，长句会被撑成一行不折 */
.grammar-ex { display:flex; align-items:flex-start; padding:14rpx 0; border-bottom:1rpx solid #EEF4F1; }
.grammar-ex:last-child { border-bottom:none; }
.grammar-ex-text { flex:1; min-width:0; font-size:27rpx; line-height:1.75; color:#43504C; white-space:normal; word-break:break-word; overflow-wrap:break-word; }
.ex-no { flex-shrink:0; width:36rpx; height:36rpx; border-radius:50%; background:#E6F4EE; color:#176B5B; font-size:22rpx; font-weight:700; display:flex; align-items:center; justify-content:center; margin:8rpx 14rpx 0 0; }
.ex-speak { flex-shrink:0; width:52rpx; height:52rpx; border-radius:50%; background:#E6F4EE; color:#176B5B; display:flex; align-items:center; justify-content:center; font-size:26rpx; margin-left:16rpx; }
.ex-speak.playing { background:#176B5B; color:#fff; }
.ex-speak.speak-hover { background:#CBE6DC; }
.ex-speak.playing.speak-hover { background:#0E4C41; }
.checkin-btn { margin:24rpx 0; }
.done-state { text-align:center; color:#176B5B; font-size:28rpx; font-weight:700; padding:16rpx 0; }

/* 开溜 · 图标与触控视觉统一 */
.icon-button{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;border-radius:18rpx;background:#E6F4EE;color:#176B5B;font-size:30rpx;line-height:1;}
.icon-button:active{background:#D5EDE3;}
.icon-star{font-size:34rpx;color:#C7D0CC;}
.icon-star--on{color:#F5C451;}
.icon-remove{font-size:28rpx;color:#A6B2AD;}
.icon-speaker{font-size:28rpx;}

/* 全局按压反馈（hover-class 挂这些类）：
   原生按钮统一「背景变色 + 轻缩放」（不再用透明度——有的按钮看得见有的看不见）；
   文字/图标类（无背景）用变暗 + 缩放 */
.hover-dim{opacity:.55;transform:scale(.96)}
.btn-press{transform:scale(.96)}
.btn-primary.btn-press{background:#0E4C41}
.btn-ghost.btn-press{background:#DCEFE7}
.btn-ghost.btn-voice-on.btn-press{background:#0E4C41;color:#fff}
/* 播放喇叭：SVG 贴图。🔊 emoji 字形基线/光学中心不稳，在圆形按钮内总不居中；
   改矢量喇叭，尺寸用 em 跟随容器字号（word-speak 34rpx→约30rpx，ex-speak 26rpx→约23rpx） */
.spk-ico{display:block;width:.88em;height:.88em;background:center/contain no-repeat;background-image:url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M3%209v6h4l5%205V4L7%209H3z%20M16.5%2012c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73%202.5-2.25%202.5-4.02z%20M14%203.23v2.06c2.89.86%205%203.54%205%206.71s-2.11%205.85-5%206.71v2.06c4.01-.91%207-4.49%207-8.77s-2.99-7.86-7-8.77z'%20fill='%23176B5B'/%3E%3C/svg%3E");}
.spk-ico--on{background-image:url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M3%209v6h4l5%205V4L7%209H3z%20M16.5%2012c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73%202.5-2.25%202.5-4.02z%20M14%203.23v2.06c2.89.86%205%203.54%205%206.71s-2.11%205.85-5%206.71v2.06c4.01-.91%207-4.49%207-8.77s-2.99-7.86-7-8.77z'%20fill='%23FFFFFF'/%3E%3C/svg%3E");}

/* 歌词式朗读进度：已读部分品牌绿，未读保持原色（kara-lit 放在词首 text 上） */
.kara-lit{color:#176B5B}

/* 收藏心形：不用 ♡/♥ 字符（部分机型字体把两个都渲染成实心，形状分不出来），
   改用 SVG 贴图——空心圆润描边 vs 实心填充，收藏前后是两个不同的形状 */
.star-ico{width:40rpx;height:36rpx;background:center/contain no-repeat;}
.star-ico--off{background-image:url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M12%2020.1C7.7%2016.9%204%2013.7%203%2010.7%202.1%207.8%203.8%205.1%206.6%204.6%208.5%204.3%2010.5%205.2%2012%206.9%2013.5%205.2%2015.5%204.3%2017.4%204.6%2020.2%205.1%2021.9%207.8%2021%2010.7%2020%2013.7%2016.3%2016.9%2012%2020.1Z'%20fill='none'%20stroke='%23C7D0CC'%20stroke-width='1.8'%20stroke-linejoin='round'/%3E%3C/svg%3E");}
.star-ico--on{background-image:url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M12%2020.1C7.7%2016.9%204%2013.7%203%2010.7%202.1%207.8%203.8%205.1%206.6%204.6%208.5%204.3%2010.5%205.2%2012%206.9%2013.5%205.2%2015.5%204.3%2017.4%204.6%2020.2%205.1%2021.9%207.8%2021%2010.7%2020%2013.7%2016.3%2016.9%2012%2020.1Z'%20fill='%23FF8A78'/%3E%3C/svg%3E");}

/* ── iPad / 宽屏适配（纯追加，不影响手机端）──
   rpx 按「窗口宽度/750」换算，iPad Pro 窗口宽 1000px+ 时所有尺寸被放大约 3 倍。
   ≥700px 时改用固定 px 并把内容限宽居中，字号取手机端 ×0.5rpx 值。 */
@media (min-width: 700px) {
  page { font-size: 15px; padding-bottom: calc(66px + env(safe-area-inset-bottom)); }
  .card { max-width: 640px; margin: 12px auto; border-radius: 12px; padding: 14px; box-sizing: border-box; }
  .section-label { font-size: 14px; margin-bottom: 7px; }
  .btn-primary { border-radius: 22px; font-size: 15px; }
  .btn-ghost { border-width: 1px; border-radius: 22px; font-size: 15px; }
  .tip-box { border-left-width: 3px; border-radius: 7px; padding: 10px 12px; margin-top: 10px; }
  .tip-text { font-size: 13px; }
  .muted { font-size: 12px; }
  .brand-head { max-width: 640px; margin: 0 auto; width: 100%; box-sizing: border-box; padding: 10px 14px 2px; }
  .brand-logo { width: 38px; height: 38px; }
  .brand-copy { margin-left: 8px; }
  .brand-name { font-size: 18px; }
  .brand-sub { font-size: 11px; margin-top: 3px; }
  .word-row { padding: 9px 0; }
  .word-speak { width: 32px; height: 32px; font-size: 17px; margin-right: 10px; }
  .word-en { font-size: 16px; }
  .word-pos { font-size: 11px; margin-left: 5px; }
  .word-zh { font-size: 13px; margin-top: 2px; }
  .word-example { font-size: 13px; margin-top: 3px; padding-left: 2px; }
  .word-star { width: 32px; height: 32px; font-size: 20px; }
  .grammar-ex { padding: 7px 0; }
  .grammar-ex-text { font-size: 14px; }
  .ex-no { width: 18px; height: 18px; font-size: 11px; margin: 4px 7px 0 0; }
  .ex-speak { width: 26px; height: 26px; font-size: 13px; margin-left: 8px; }
  .checkin-btn { margin: 12px 0; }
  .done-state { font-size: 14px; padding: 8px 0; }
  .icon-button { width: 32px; height: 32px; border-radius: 9px; font-size: 15px; }
  .icon-star { font-size: 17px; }
  .icon-remove, .icon-speaker { font-size: 14px; }
  .star-ico { width: 20px; height: 18px; }
}
