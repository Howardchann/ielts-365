/* app.wxss：全局样式（沿用 H5 版的暖色学习风格） */
page {
  background: #F7F4EC;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #B8860B;
  margin-bottom: 14rpx;
  letter-spacing: 2rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #D4A017, #B8860B);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary[disabled] {
  background: #d9d9d9;
  color: #fff;
}

.btn-ghost {
  background: #fff;
  color: #B8860B;
  border: 2rpx solid #B8860B;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.tip-box {
  background: #FFF9E6;
  border-left: 6rpx solid #B8860B;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 20rpx;
}

.tip-text {
  color: #7A6230;
  font-size: 26rpx;
}

.muted { color: #999; font-size: 24rpx; }

/* 词汇行 */
.word-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0EDE4;
}

.word-row:last-child { border-bottom: none; }

.word-speak {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFF3D6;
  color: #B8860B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
}

.word-speak.playing { background: #B8860B; color: #fff; }

.word-main { flex: 1; min-width: 0; }

.word-en { font-size: 32rpx; font-weight: 600; color: #2C3E50; }

.word-pos { font-size: 22rpx; color: #B8860B; font-style: italic; margin-left: 10rpx; }

.word-zh { font-size: 26rpx; color: #666; margin-top: 4rpx; }

.word-example {
  font-size: 25rpx;
  color: #888;
  margin-top: 6rpx;
  padding-left: 4rpx;
}

.word-star {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #ccc;
}

.word-star.on { color: #E67E22; }

/* 语法例句 */
.grammar-ex {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.grammar-ex-text { flex: 1; font-size: 27rpx; color: #444; }

.ex-speak {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #EAF4EA;
  color: #2E7D32;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-left: 16rpx;
}

/* 打卡按钮 */
.checkin-btn {
  margin: 24rpx 0;
}

.done-state {
  text-align: center;
  color: #2E7D32;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 0;
}
